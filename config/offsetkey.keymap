#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/toggle_io.dtsi>
#include <behaviors/on_io.dtsi>
#include <behaviors/off_io.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>
#include <locale/keys_de.h>

#define QWERTZ 0
#define FUNMED 1
#define NAVNUM 2
#define SYMBOL 3
#define CONFIG 4

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 320

&mt { quick-tap-ms = <200>; };
&lt {
    quick-tap-ms = <200>;
    flavor = "hold-preferred";
};
&sk { release-after-ms = <2000>; quick-release; };

/ {
    macros {
    lm:  lm  {
        compatible = "zmk,behavior-macro-two-param";
        #binding-cells = <2>;
        wait-ms = <0>;
        tap-ms = <0>;
        bindings = <&macro_param_1to1>, <&macro_press &mo MACRO_PLACEHOLDER>, <&macro_param_2to1>,
            <&macro_press &kp MACRO_PLACEHOLDER>, <&macro_pause_for_release>, <&macro_param_2to1>,
            <&macro_release &kp MACRO_PLACEHOLDER>, <&macro_param_1to1>, <&macro_release &mo MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <20>; // Scroll tap duration
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            label = "QWERTZ";
            sensor-bindings = <&scroll_up_down>;
            bindings = <
&kp ESC         &kp DE_CARET    &kp DE_N1       &kp DE_N2       &kp DE_N3       &kp DE_N4       &kp DE_N5       &kp DE_N6       &kp DE_N7       &kp DE_N8       &kp DE_N9       &kp DE_N0       &kp DE_ESZETT   &kp BSPC        &kp F5          &kp N6
&kp TAB         &kp DE_Q        &kp DE_W        &kp DE_E        &kp DE_R        &kp DE_T        &kp DE_Z        &kp DE_U        &kp DE_I        &kp DE_O        &kp DE_P        &kp DE_U_UMLAUT &kp DE_PLUS     &kp DE_HASH     &kp PG_UP       &kp T
&mt LCTRL ESC   &kp DE_A        &kp DE_S        &kp DE_D        &kp DE_F        &kp DE_G        &kp DE_H        &kp DE_J        &kp DE_K        &kp DE_L        &kp DE_O_UMLAUT &kp DE_A_UMLAUT &kp ENTER                       &kp PG_DN       &kp G
&kp LSHFT       &kp DE_Y        &kp DE_X        &kp DE_C        &kp DE_V        &kp DE_B        &kp DE_N        &kp DE_M        &kp DE_COMMA    &kp DE_DOT      &kp DE_MINUS    &kp RSHFT                       &kp UP          &kp DEL         &kp B
&kp LCTRL       &kp LGUI        &kp LALT        &lt FUNMED CAPS &lt NAVNUM SPACE                &lt SYMBOL SPACE                &kp RALT        &kp RGUI        &kp RCTRL                       &kp LEFT        &kp DOWN        &kp RIGHT       &kp SPACE

&kp UP_ARROW  &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp DOWN_ARROW  &kp ENTER  &kp SPACE             &mkp LCLK  &mkp LCLK  &mkp RCLK      &none
            >;
        };

        FUNMED {
            label = "FUNMED";
            sensor-bindings = <&scroll_up_down>;
            bindings = <
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
&kp K_APP       &kp F12         &kp F9          &kp F8          &kp F7          &kp PSCRN       &kp C_VOL_UP    &mkp MB4        &msc SCRL_UP    &mkp MB5        &kp C_PREV      &kp C_BRI_UP    &trans          &trans          &trans          &trans
&sk LCTRL       &kp F11         &kp F6          &kp F5          &kp F4          &kp SLCK        &kp C_VOL_DN    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT &kp C_NEXT      &kp C_BRI_DN    &trans                          &trans          &trans
&sk LSHFT       &kp F10         &kp F3          &kp F2          &kp F1          &kp PAUSE_BREAK &kp C_MUTE      &mkp LCLK       &mkp MCLK       &mkp RCLK       &kp C_PP        &trans                          &trans          &trans          &trans
&sk LCTRL       &sk LGUI        &sk LALT        &trans          &lm NAVNUM LALT                 &trans                          &trans          &trans          &trans                          &trans          &trans          &trans          &trans
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        NAVNUM {
            label = "NAVNUM";
            sensor-bindings = <&scroll_up_down>;
            bindings = <
&kp GRAVE       &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &kp F11         &kp F12         &kp K_APP       &trans          &trans
&kp HOME        &kp END         &kp BSPC        &kp UP          &kp DEL         &kp PG_UP       &kp KP_NLCK     &kp KP_N7       &kp KP_N8       &kp KP_N9       &kp KP_MINUS    &kp PSCRN       &kp SLCK        &kp PAUSE_BREAK &trans          &trans
&sk LCTRL       &kp ENTER       &kp LEFT        &kp DOWN        &kp RIGHT       &kp PG_DN       &kp KP_DIVIDE   &kp KP_N4       &kp KP_N5       &kp KP_N6       &kp KP_PLUS     &kp INS         &kp KP_ENTER                    &trans          &trans
&sk LSHFT       &mkp MB4        &mkp RCLK       &mkp MCLK       &mkp LCLK       &mkp MB5        &kp KP_MULTIPLY &kp KP_N1       &kp KP_N2       &kp KP_N3       &kp KP_DOT      &trans                          &kp PG_UP       &trans          &trans
&sk LCTRL       &sk LGUI        &lt CONFIG INS  &kp LALT        &trans                          &kp KP_N0                       &trans          &trans          &trans                          &kp HOME        &kp PG_DN       &kp END         &trans
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        SYMBOL {
            label =  "SYMBOL";
            sensor-bindings = <&scroll_up_down>;
            bindings = <
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans                &trans          &trans
&kp DE_TILDE    &kp DE_EXCL     &kp DE_AT       &kp DE_POUND    &kp DE_DLLR     &kp DE_PRCNT    &kp DE_CARET    &kp DE_AMPS     &kp DE_STAR     &kp DE_LPAR     &kp RPAR        &kp DE_LBRC     &kp DE_RBRC     &kp DE_CAPITAL_SZ     &trans          &trans
&sk LCTRL       &kp DE_SQT      &kp DE_DQT      &kp DE_LBRC     &kp DE_RBRC     &kp DE_PIPE     &kp DE_PLUS     &kp DE_EQUAL    &kp DE_LPAR     &kp DE_RPAR     &kp DE_COLON    &kp DE_DQT      &trans                                &trans          &trans
&sk LSHFT       &kp DE_GRAVE    &kp DE_TILDE    &kp DE_LBKT     &kp DE_RBKT     &kp DE_BSLH     &kp DE_UNDER    &kp DE_MINUS    &kp DE_LT       &kp DE_GT       &kp DE_QMARK    &trans                          &trans                &trans          &trans
&sk LCTRL       &sk LGUI        &sk LALT        &caps_word      &kp DE_UNDER                    &trans                          &trans          &trans          &trans                          &trans          &trans                &trans          &trans
&kp C_BRI_UP    &kp C_PREV      &kp C_NEXT      &kp C_BRI_DN    &kp C_PP        &trans          &trans          &trans          &trans          &trans
            >;
        };

        CONFIG {
            label = "CONFIG";
            sensor-bindings = <&scroll_up_down>;
            bindings = <
&bt BT_CLR      &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &bt BT_DISC 0   &bt BT_DISC 1   &bt BT_DISC 2   &bt BT_DISC 3   &bt BT_DISC 4   &bt BT_PRV      &bt BT_NXT      &bt BT_CLR_ALL  &trans          &trans
&trans          &trans          &trans          &trans          &trans          &trans          &rgb_ug RGB_EFR &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_BRI &rgb_ug RGB_SPI &out OUT_USB    &out OUT_BLE    &out OUT_TOG    &trans          &trans
&trans          &trans          &trans          &trans          &trans          &trans          &rgb_ug RGB_EFF &rgb_ug RGB_HUD &rgb_ug RGB_SAD &rgb_ug RGB_BRD &rgb_ug RGB_SPD &rgb_ug RGB_OFF &rgb_ug RGB_ON                  &trans          &trans
&sys_reset      &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &sys_reset                      &trans          &trans          &trans
&bootloader     &trans          &trans          &trans          &trans                          &rgb_ug RGB_TOG                 &trans          &trans          &bootloader                     &trans          &trans          &trans          &trans
&trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };
    };
};
